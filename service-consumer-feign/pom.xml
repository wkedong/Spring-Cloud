<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <artifactId>service-consumer-feign</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>service-consumer-feign</name>
    <description>Demo project for Spring Boot</description>

    <parent>
        <groupId>com.wkedong.springcloud</groupId>
        <artifactId>parent</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <!-- starter 更名：spring-cloud-starter-eureka → netflix-eureka-client -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-netflix-eureka-client</artifactId>
        </dependency>
        <!-- Feign 的服务间负载均衡依赖 LoadBalancer（原由 Ribbon 提供） -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-loadbalancer</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- Micrometer → Prometheus 注册表：暴露 /actuator/prometheus（版本由 spring-boot-dependencies 统一管理，无需写 version） -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-config</artifactId>
        </dependency>
        <!-- starter 更名：spring-cloud-starter-feign → spring-cloud-starter-openfeign -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-openfeign</artifactId>
        </dependency>
        <!-- feign-micrometer：Feign 的 Micrometer 观测能力（客户端 span + 传播头注入）在独立构件里，
             OpenFeign 核心不含它。缺了它：客户端 span 不会产生、traceId 不会写进下游请求头，
             Zipkin 里下游会另起一条新 trace（本机实测踩到）。版本由 OpenFeign BOM 统一管理。 -->
        <dependency>
            <groupId>io.github.openfeign</groupId>
            <artifactId>feign-micrometer</artifactId>
        </dependency>
        <!-- CircuitBreaker 抽象 + Resilience4j 实现：Feign 的 fallbackFactory 依赖它 -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-circuitbreaker-resilience4j</artifactId>
        </dependency>
        <!-- Sleuth 已在 Spring Cloud 2022+ 退役：改用 Micrometer Tracing（Brave 桥接）+ Zipkin 上报 -->
        <!-- Boot 4 把链路追踪也拆成了独立模块：Tracer/Zipkin 上报的自动配置不再随 actuator 传递。
             spring-boot-starter-zipkin 一次带齐四件套：
               spring-boot-micrometer-tracing(-brave)（Tracer/传播器自动配置）
               + spring-boot-zipkin（按 management.zipkin.tracing.endpoint 上报）
               + micrometer-tracing-bridge-brave（Brave 桥接）
               + zipkin-reporter-brave（Zipkin 上报器）
             只加桥接包（Boot 3 的写法）在 Boot 4 下会缺 io.micrometer.tracing.Tracer bean，启动直接失败。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-zipkin</artifactId>
        </dependency>
        <!-- fastjson 升级到安全修复版 -->
        <dependency>
            <groupId>com.alibaba.fastjson2</groupId>
            <artifactId>fastjson2</artifactId>
            <version>${fastjson2.version}</version>
        </dependency>
        <!-- 升级说明（OpenFeign 5.0.3 / feign 13.6.1）：feign-form 已被收编进 OpenFeign 主仓库，
             坐标从 io.github.openfeign.form:feign-form(-spring):3.8.0 迁到
             io.github.openfeign:feign-form(-spring):13.6.1（由 OpenFeign BOM 管理，无需写版本）。
             ⚠️ 两个坐标的 groupId 不同，**旧的显式依赖不删就是两套同名类共存**：
                feign.form.spring.SpringFormEncoder 会同时出现在 3.8.0 与 13.6.1 两个 jar 里，
                fat jar 的 BOOT-INF/lib 下也确实并存（本机实测），加载到哪一份取决于 classpath 顺序。
             13.6.1 的 SpringFormEncoder 仍是无参构造 + 原生支持 MultipartFile，
             使用方代码（new SpringFormEncoder()）不用改，所以这里直接删掉旧坐标。 -->
        <dependency>
            <groupId>io.github.openfeign</groupId>
            <artifactId>feign-form-spring</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
