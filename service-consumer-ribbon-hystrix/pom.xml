<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <artifactId>service-consumer-ribbon-hystrix</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>service-consumer-ribbon-hystrix</name>
    <description>Demo project for Spring Boot</description>

    <parent>
        <groupId>com.wkedong.springcloud</groupId>
        <artifactId>parent</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <!-- starter 更名：spring-cloud-starter-eureka → netflix-eureka-client -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-netflix-eureka-client</artifactId>
        </dependency>
        <!-- spring-cloud-starter-ribbon 已移除：负载均衡改由 Spring Cloud LoadBalancer 提供 -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-loadbalancer</artifactId>
        </dependency>
        <!-- spring-cloud-starter-hystrix / hystrix-dashboard 已移除：
             熔断器改由官方替代实现 Spring Cloud CircuitBreaker + Resilience4j 提供 -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-circuitbreaker-resilience4j</artifactId>
        </dependency>
        <!-- resilience4j-all：补全 Bulkhead / Decorators 等模块
             （starter 默认只带 circuitbreaker/ratelimiter/retry/timelimiter，不含 bulkhead 与装饰器组合 API） -->
        <dependency>
            <groupId>io.github.resilience4j</groupId>
            <artifactId>resilience4j-all</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- Micrometer → Prometheus 注册表：暴露 /actuator/prometheus（版本由 spring-boot-dependencies 统一管理，无需写 version） -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-config</artifactId>
        </dependency>
        <!-- Sleuth 已在 Spring Cloud 2022+ 退役：改用 Micrometer Tracing（Brave 桥接）+ Zipkin 上报 -->
        <!-- Boot 4 把链路追踪也拆成了独立模块：Tracer/Zipkin 上报的自动配置不再随 actuator 传递。
             spring-boot-starter-zipkin 一次带齐四件套：
               spring-boot-micrometer-tracing(-brave)（Tracer/传播器自动配置）
               + spring-boot-zipkin（按 management.zipkin.tracing.endpoint 上报）
               + micrometer-tracing-bridge-brave（Brave 桥接）
               + zipkin-reporter-brave（Zipkin 上报器）
             只加桥接包（Boot 3 的写法）在 Boot 4 下会缺 io.micrometer.tracing.Tracer bean，启动直接失败。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-zipkin</artifactId>
        </dependency>
        <!-- 原 fastjson 依赖：本模块代码未使用，升级时一并移除 -->
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
