<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.wkedong.springcloud</groupId>
    <artifactId>parent</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>parent</name>
    <packaging>pom</packaging>
    <description>Demo project for Spring Boot</description>

    <!-- 最新 GA 版本线：Spring Boot 4.0.x（Spring Framework 7、Jakarta EE 11、Java 17 基线） -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.0.8</version>
        <relativePath/>
    </parent>

    <properties>
        <!-- Boot 4 的基线是 Java 17：不再支持 8/11 -->
        <java.version>17</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- Spring Cloud 2025.1.x（Northfields 之后的 2025.1 线）官方配对 spring-boot.version=4.0.8 -->
        <spring-cloud.version>2025.1.3</spring-cloud.version>
        <!-- Spring Cloud Alibaba 2025.1.0.0：Nacos 客户端 3.1.1 / Sentinel 1.8.9 / Seata 2.5.0 -->
        <spring-cloud-alibaba.version>2025.1.0.0</spring-cloud-alibaba.version>
        <!-- fastjson2：fastjson 1.x 已停止维护，1.x 的 JSON/JSONObject API 在 2.x 保持兼容 -->
        <fastjson2.version>2.0.65</fastjson2.version>
        <!-- Jackson 2：Boot 4 只带 Jackson 3，旧生态（Seata 等）仍需 2.x，显式管理版本 -->
        <jackson2.version>2.21.7</jackson2.version>
    </properties>

    <modules>
        <!-- Eureka注册中心-->
        <module>eureka</module>
        <!-- 配置中心-->
        <module>config</module>
        <!-- 智能网关路由（Zuul 已退役，内部改用 Spring Cloud Gateway 实现；目录名沿用历史名）-->
        <module>zuul</module>
        <!-- Zipkin服务追踪：Zipkin 2.14+ 不再以 Spring Boot 库形式发行，
             本分支改为 docker-compose 启动官方独立 Zipkin（见根目录 docker-compose.yml 与 docs/07），
             原 zipkin 自建模块已删除（库形态已废弃）
        <module>zipkin</module>-->
        <!--服务生产者-->
        <module>service-producer</module>
        <!-- 服务消费者-->
        <module>service-consumer</module>
        <!-- Feign服务消费者-->
        <module>service-consumer-feign</module>
        <!-- 带有负载均衡的消费者-->
        <module>service-consumer-ribbon</module>
        <!-- 带有熔断机制的消费者-->
        <module>service-consumer-ribbon-hystrix</module>
        <!-- Spring Boot 本体教学：Web 层工程化、配置体系、缓存/异步/事务、Actuator、优雅停机、测试 -->
        <module>springboot-basics</module>
        <!-- 自定义 Spring Boot Starter：自动配置原理教学（被 springboot-basics 依赖） -->
        <module>basics-audit-spring-boot-starter</module>
        <!-- Nacos：注册中心与配置中心（替代 Eureka + Config 的新一代方案） -->
        <module>nacos-demo</module>
        <!-- Sentinel：流量控制与熔断降级（Alibaba 系容错方案） -->
        <module>sentinel-demo</module>
        <!-- Spring Cloud Stream：消息驱动微服务（Kafka Binder） -->
        <module>stream-demo</module>
        <!-- Spring Security + JWT：认证与授权 -->
        <module>security-demo</module>
        <!-- Seata：分布式事务（AT 模式） -->
        <module>seata-demo</module>
    </modules>


    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- Spring Cloud Alibaba：Nacos / Sentinel / Seata 的版本管理 -->
            <dependency>
                <groupId>com.alibaba.cloud</groupId>
                <artifactId>spring-cloud-alibaba-dependencies</artifactId>
                <version>${spring-cloud-alibaba.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
        </dependency>
        <!-- Boot 4 把测试自动配置按技术栈拆成独立模块：
             @WebMvcTest / @AutoConfigureMockMvc 从 spring-boot-test-autoconfigure
             搬到了 spring-boot-webmvc-test（starter-test 不再传递依赖它），切片测试必须显式引入。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- compiler：Boot 4 父 POM 已按 java.version 设置 release，这里仅固定编码 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <release>${java.version}</release>
                    <encoding>${project.build.sourceEncoding}</encoding>
                </configuration>
            </plugin>
            <!-- resources -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <configuration>
                    <encoding>${project.build.sourceEncoding}</encoding>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
