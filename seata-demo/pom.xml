<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <artifactId>seata-demo</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>seata-demo</name>
    <description>Seata 教学模块（聚合）：订单服务 + 库存服务，演示 AT 模式分布式事务</description>

    <parent>
        <groupId>com.wkedong.springcloud</groupId>
        <artifactId>parent</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <modules>
        <module>seata-order</module>
        <module>seata-inventory</module>
    </modules>

    <!-- 两个子模块共用：Seata 客户端还需要 Jackson 2 -->
    <dependencies>
        <!-- 升级必加（Boot 4 + Seata 2.5.0）：Boot 4 用 Jackson 3（tools.jackson.*）并移除了 Jackson 2，
             而 Seata 客户端内部仍硬编码 com.fasterxml.jackson.core.*，运行时会炸：
               NoClassDefFoundError: com/fasterxml/jackson/core/JsonProcessingException
             外在表现是下单直接失败 Could not open JDBC Connection for transaction、xid=null，
             极易被误判成数据库/驱动问题（本机实测踩过）。
             Boot 4 的 BOM 已不管理 Jackson 2，所以这里必须显式带版本（见根 pom 的 jackson2.version）。 -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>${jackson2.version}</version>
        </dependency>
    </dependencies>

</project>
